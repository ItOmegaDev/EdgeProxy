rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tunnels/{tunnelId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /traffic_logs/{logId} {
      allow read, write: if true;
    }
    match /rate_limit_rules/{ruleId} {
      allow read, write: if true;
    }
  }
}
