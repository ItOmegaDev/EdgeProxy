# ==========================================================
# EdgeProxy environment template
# Copy to .env and fill in locally. Never commit .env.
# ==========================================================

# --- Control plane (Node.js) ---
PORT=3000
# Bind loopback by default. If you bind a non-loopback address you MUST set
# EDGEPROXY_API_KEY, otherwise the process refuses to start.
HOST=127.0.0.1
NODE_ENV=development

# Admin API key for the control plane. Generate with:
#   openssl rand -hex 32
# URL-safe characters only. Required for any non-loopback binding.
EDGEPROXY_API_KEY=

# Optional extra origins allowed to call the API (comma-separated).
# Example: https://edge.example.com
EDGEPROXY_ALLOWED_ORIGINS=

# Where the control plane finds the Go gateway's public HTTP ingress.
GATEWAY_PUBLIC_URL=http://127.0.0.1:8080

# --- Private gateway IPC (Node <-> Go) ---
# Shared secret for /internal/*. Generate with: openssl rand -hex 32
# When set, the gateway exposes IPC on EDGEPROXY_INTERNAL_ADDR; when empty the
# gateway disables IPC entirely.
EDGEPROXY_INTERNAL_SECRET=
EDGEPROXY_INTERNAL_ADDR=127.0.0.1:8081
GATEWAY_INTERNAL_URL=http://127.0.0.1:8081

# --- Firebase Admin ---
# Provide ONE credential source:
#   1) FIREBASE_SERVICE_ACCOUNT_JSON: raw JSON or base64-encoded service account
#   2) GOOGLE_APPLICATION_CREDENTIALS: path to the service-account JSON file
#   3) FIREBASE_PROJECT_ID with Application Default Credentials
# Without credentials the control plane runs with in-memory state only.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional initial admin record. Only a hash of the key is stored.
# Leave empty to disable seeding (recommended).
SEED_ADMIN_API_KEY=
SEED_ADMIN_EMAIL=

# --- Server-side AI diagnostics ---
# Optional. When empty, deterministic heuristic diagnostics are used.
GEMINI_API_KEY=

# Public URL of this applet, used for self-referential links.
APP_URL=
